{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HyperFrames",
  "version": "0.6.51",
  "identifier": "com.hyperframes.studio",
  "build": {
    "frontendDist": "../frontend-stub"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "HyperFrames",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "visible": false,
        "decorations": true,
        "fullscreen": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "copyright": "© 2026 HyperFrames",
    "shortDescription": "Create HTML-defined videos locally.",
    "longDescription": "HyperFrames Studio packages the open-source HyperFrames video framework as a local desktop app. Everything runs on your machine — no cloud, no remote APIs.",
    "externalBin": ["binaries/hyperframes"],
    "resources": ["resources/**/*"],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "localhost"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/heygen-com/hyperframes/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_PUBKEY_FROM_TAURI_SIGNER_GENERATE"
    }
  }
}
