{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 180,
            "statusMessage": "Running build + lint + typecheck before commit…",
            "command": "node .claude/pre-commit-check.mjs"
          }
        ]
      }
    ]
  }
}
